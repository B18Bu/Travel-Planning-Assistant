# 应用运行环境名称，默认值：development；仅后端读取，不接受客户端覆盖。
APP_ENV=development
# 浏览器允许访问的同源前端地址列表，默认值：http://localhost:5173；仅后端 CORS 控制，不接受客户端覆盖。
ALLOWED_ORIGINS=["http://localhost:5173"]
# 飞猪门票 provider，默认 disabled；仅允许 disabled、mock、flyai。
FLIGGY_TICKET_PROVIDER=disabled
# FlyAI 服务端密钥，默认空值；仅在后端使用，不得提交真实值或暴露到前端。
FLYAI_API_KEY=
# FlyAI 请求总超时，单位：秒，默认值：30，范围：1—120；仅后端控制。
FLYAI_TIMEOUT_SECONDS=30
# 飞猪门票真实查询开关，默认关闭；没有正式授权和凭据时不得开启。
FLIGGY_ENABLED=false
# 门票 Mock 演示开关，默认关闭；开启后仅返回明确标注的演示数据，不访问飞猪。
FLIGGY_MOCK_ENABLED=false

# 和风天气逐日预报 API 的服务端密钥，默认空值；仅在后端使用，不得提交真实值或暴露到前端。
HEWEATHER_API_KEY=
# 和风天气固定 HTTPS API 域名，默认值：https://pb5ctx5qqr.re.qweatherapi.com；仅后端控制，客户端不可覆盖。
HEWEATHER_BASE_URL=https://pb5ctx5qqr.re.qweatherapi.com
# 高德地理编码、驾车路线和 POI 文本搜索 API 的服务端密钥，默认空值；仅在后端使用，不得提交真实值或暴露到前端。
AMAP_API_KEY=
# 高德地图固定 HTTPS API 域名，默认值：https://restapi.amap.com；仅后端控制，客户端不可覆盖。
AMAP_BASE_URL=https://restapi.amap.com

# MinerU 云端 PDF 解析服务密钥，默认空值；仅在后端使用，不得提交真实值或暴露到前端。
MINERU_API_KEY=
# MinerU 固定 HTTPS API 域名，默认值：https://mineru.net；仅后端控制，客户端不可覆盖。
MINERU_BASE_URL=https://mineru.net
# Qwen-VL 图表 OCR 服务密钥，默认空值；仅在后端使用，不得提交真实值或暴露到前端。
QWEN_VL_API_KEY=
# Qwen-VL 固定 HTTPS API 域名，默认值：https://dashscope.aliyuncs.com/compatible-mode/v1；仅后端控制，客户端不可覆盖。
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen-VL 图表 OCR 模型，默认值：qwen-vl-max；仅后端控制，客户端不可覆盖。
QWEN_VL_MODEL=qwen-vl-max
# DeepSeek 大模型润色的服务端密钥，默认空值；仅在后端使用，不得提交真实值或暴露到前端。
DEEPSEEK_API_KEY=
# DeepSeek 固定 HTTPS API 域名，默认值：https://api.deepseek.com；仅后端控制，客户端不可覆盖。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 润色模型，默认值：deepseek-chat；仅后端控制，客户端不可覆盖。
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek 单次生成最大 token 数，默认值：2000，范围：256—8192；仅后端控制，客户端不可覆盖。
DEEPSEEK_MAX_TOKENS=2000
# DeepSeek 单次生成请求总超时，单位：秒，默认值：60.0；仅后端控制，客户端不可覆盖。
DEEPSEEK_TIMEOUT_SECONDS=60
# 本地 BGE embedding 模型路径，默认值：D:\作业\model\bge-small-zh-v1.5；仅后端读取。
BGE_MODEL_PATH=D:\作业\model\bge-small-zh-v1.5
# 文档文件、解析产物和向量索引目录，默认值：backend/data；仅后端读取。
DOCUMENT_DATA_DIR=backend/data
# Chroma 文档集合名称，默认值：travel_documents；仅后端控制，客户端不可覆盖。
CHROMA_COLLECTION_NAME=travel_documents
# 单个文档最大上传字节数，单位：字节，默认值：20971520；仅后端控制，客户端不可覆盖。
DOCUMENT_MAX_UPLOAD_BYTES=20971520
# 单次文档批量上传最大文件数，默认值：10，范围：1—20；仅后端控制，客户端不可覆盖。
DOCUMENT_BATCH_MAX_FILES=10
# 知识检索最终返回结果数，默认值：12，范围：1—50；仅后端控制，客户端不可覆盖。
KNOWLEDGE_SEARCH_RESULT_LIMIT=12

# 所有外部 API HTTP 连接建立超时，单位：秒，默认值：3.0；仅后端控制，客户端不可覆盖。
EXTERNAL_CONNECT_TIMEOUT_SECONDS=3
# 所有外部 API HTTP 响应读取超时，单位：秒，默认值：8.0；仅后端控制，客户端不可覆盖。
EXTERNAL_READ_TIMEOUT_SECONDS=8
# 所有外部 API 单次请求总超时，单位：秒，默认值：10.0；仅后端控制，客户端不可覆盖。
EXTERNAL_TOTAL_TIMEOUT_SECONDS=10
# 和风天气及高德 API 的最大请求尝试次数，单位：次，默认值：3；仅用于受控瞬时错误重试；仅后端控制，客户端不可覆盖。
EXTERNAL_MAX_ATTEMPTS=3
# 和风天气或高德 API 连续失败的熔断阈值，单位：次，默认值：3；仅后端控制，客户端不可覆盖。
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# 和风天气或高德 API 熔断保持时长，单位：秒，默认值：60；仅后端控制，客户端不可覆盖。
CIRCUIT_BREAKER_OPEN_SECONDS=60

# 和风天气逐日预报结果的进程内缓存 TTL，单位：秒，默认值：1800；仅后端控制，客户端不可覆盖。
WEATHER_CACHE_TTL_SECONDS=1800
# 高德地理编码结果的进程内缓存 TTL，单位：秒，默认值：604800；仅后端控制，客户端不可覆盖。
AMAP_GEOCODE_CACHE_TTL_SECONDS=604800
# 高德驾车路线结果的进程内缓存 TTL，单位：秒，默认值：900；仅后端控制，客户端不可覆盖。
AMAP_ROUTE_CACHE_TTL_SECONDS=900
# 高德 POI 搜索结果的进程内缓存 TTL，单位：秒，默认值：3600；仅后端控制，客户端不可覆盖。
AMAP_POI_CACHE_TTL_SECONDS=3600
