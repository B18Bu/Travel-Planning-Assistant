# 应用运行环境名称，用于区分开发、测试和生产环境。
APP_ENV=development
# 浏览器允许访问的同源前端地址列表，仅用于后端 CORS 配置。
ALLOWED_ORIGINS=["http://localhost:5173"]

# 和风天气逐日预报 API 的服务端密钥；不得提交真实值或暴露到前端。
HEWEATHER_API_KEY=
# 和风天气固定 HTTPS API 域名，仅用于后端请求，不允许客户端覆盖。
HEWEATHER_BASE_URL=https://devapi.qweather.com
# 高德地理编码、驾车路线和 POI 文本搜索 API 的服务端密钥；不得提交真实值或暴露到前端。
AMAP_API_KEY=
# 高德地图固定 HTTPS API 域名，仅用于后端请求，不允许客户端覆盖。
AMAP_BASE_URL=https://restapi.amap.com

# 外部 HTTP 请求连接、读取和总超时，单位：秒。
EXTERNAL_CONNECT_TIMEOUT_SECONDS=3
EXTERNAL_READ_TIMEOUT_SECONDS=8
EXTERNAL_TOTAL_TIMEOUT_SECONDS=10
# 首次请求加重试的最大尝试次数，仅用于受控瞬时错误。
EXTERNAL_MAX_ATTEMPTS=3
# 单一服务连续失败达到该次数后打开熔断器。
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# 熔断打开的持续时间，单位：秒。
CIRCUIT_BREAKER_OPEN_SECONDS=60

# 和风天气逐日预报结果的进程内缓存时长，单位：秒。
WEATHER_CACHE_TTL_SECONDS=1800
# 高德地理编码结果的进程内缓存时长，单位：秒。
AMAP_GEOCODE_CACHE_TTL_SECONDS=604800
# 高德驾车路线结果的进程内缓存时长，单位：秒。
AMAP_ROUTE_CACHE_TTL_SECONDS=900
# 高德 POI 搜索结果的进程内缓存时长，单位：秒。
AMAP_POI_CACHE_TTL_SECONDS=3600
