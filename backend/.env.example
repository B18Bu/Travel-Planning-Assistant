# 应用运行环境名称，默认 development；仅后端读取，不接受客户端覆盖。
APP_ENV=development
# 浏览器允许访问的同源前端地址列表，默认本地前端；仅后端 CORS 控制，不接受客户端覆盖。
ALLOWED_ORIGINS=["http://localhost:5173"]

# 和风天气逐日预报 API 的服务端密钥，默认空值；仅在后端使用，不得提交真实值或暴露到前端。
HEWEATHER_API_KEY=
# 和风天气固定 HTTPS API 域名，默认 devapi.qweather.com；仅用于后端请求，不允许客户端覆盖。
HEWEATHER_BASE_URL=https://devapi.qweather.com
# 高德地理编码、驾车路线和 POI 文本搜索 API 的服务端密钥，默认空值；仅在后端使用，不得提交真实值或暴露到前端。
AMAP_API_KEY=
# 高德地图固定 HTTPS API 域名，默认 restapi.amap.com；仅用于后端请求，不允许客户端覆盖。
AMAP_BASE_URL=https://restapi.amap.com

# 所有外部 API HTTP 连接建立超时，默认 3 秒；单位：秒；仅后端控制，不接受客户端覆盖。
EXTERNAL_CONNECT_TIMEOUT_SECONDS=3
# 所有外部 API HTTP 响应读取超时，默认 8 秒；单位：秒；仅后端控制，不接受客户端覆盖。
EXTERNAL_READ_TIMEOUT_SECONDS=8
# 所有外部 API 单次请求总超时，默认 10 秒；单位：秒；仅后端控制，不接受客户端覆盖。
EXTERNAL_TOTAL_TIMEOUT_SECONDS=10
# 和风天气及高德 API 的最大请求尝试次数，默认 3 次；仅用于受控瞬时错误重试；仅后端控制，不接受客户端覆盖。
EXTERNAL_MAX_ATTEMPTS=3
# 和风天气或高德 API 连续失败的熔断阈值，默认 3 次；仅后端控制，不接受客户端覆盖。
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# 和风天气或高德 API 熔断保持时长，默认 60 秒；单位：秒；仅后端控制，不接受客户端覆盖。
CIRCUIT_BREAKER_OPEN_SECONDS=60

# 和风天气逐日预报结果的进程内缓存 TTL，默认 1800 秒；单位：秒；仅后端控制，不接受客户端覆盖。
WEATHER_CACHE_TTL_SECONDS=1800
# 高德地理编码结果的进程内缓存 TTL，默认 604800 秒；单位：秒；仅后端控制，不接受客户端覆盖。
AMAP_GEOCODE_CACHE_TTL_SECONDS=604800
# 高德驾车路线结果的进程内缓存 TTL，默认 900 秒；单位：秒；仅后端控制，不接受客户端覆盖。
AMAP_ROUTE_CACHE_TTL_SECONDS=900
# 高德 POI 搜索结果的进程内缓存 TTL，默认 3600 秒；单位：秒；仅后端控制，不接受客户端覆盖。
AMAP_POI_CACHE_TTL_SECONDS=3600
